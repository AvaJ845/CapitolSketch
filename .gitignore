# macOS
.DS_Store

# Xcode
build/
DerivedData/
*.xcuserstate
xcuserdata/
*.xcscmblueprint
*.xccheckout
*.xcresult

# Generated by xcodegen from project.yml — not source of truth
*.xcodeproj/

# SwiftPM
.build/
.swiftpm/
Tools/PTRKit/.build/
Tools/PTRKit/.swiftpm/
Packages/DisclosureKit/.build/
Packages/DisclosureKit/.swiftpm/

# seedgen scratch space (cached filing PDFs and indexes)
.cache/
ptrfetch-cache/

# Build / signing artifacts — never commit these
*.ipa
*.app.dSYM
*.dSYM.zip
*.mobileprovision
*.provisionprofile
*.p12
*.cer
*.certSigningRequest
*.p8
AuthKey_*.p8
ExportOptions.plist

# Local, machine-specific overrides (e.g. signing team)
Local.xcconfig
Signing.xcconfig

# Local secrets / env
.env
.env.*
secrets.*
